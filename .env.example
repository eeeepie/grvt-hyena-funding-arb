# HyENA / Hyperliquid — wallet private key for signing orders
HYENA_PRIVATE_KEY=0x_your_private_key_here

# GRVT — API key from GRVT trading UI
GRVT_API_KEY=your_api_key_here

# GRVT — wallet private key for order signing
GRVT_PRIVATE_KEY=0x_your_private_key_here

# GRVT — trading account ID (shown in GRVT UI)
GRVT_TRADING_ACCOUNT_ID=your_account_id_here
